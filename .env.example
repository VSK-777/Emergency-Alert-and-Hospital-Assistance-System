# =============================================================================
# UNIFIED ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Emergency Alert and Hospital Assistance System
# B.Tech Community Service Project - VVIT CSE Batch 8
#
# IMPORTANT:
# - This template defines all required environment variables for the system.
# - Copy this file to '.env' locally:
#     cp .env.example .env
# - Fill in your actual credentials and secrets.
# - Never commit '.env' with real secrets to version control.
# =============================================================================

# =============================================================================
# 1. RENDER BACKEND WEB SERVICE (Mandatory for Backend Deployment)
# Configure these in:
# Render Dashboard -> emergency-alert-and-hospital-assistance-backend -> Environment
# =============================================================================

# Active Spring Boot profile ('prod' for production with Flyway validation, 'postgres' is alias)
SPRING_PROFILES_ACTIVE=prod

# Server listening port (Render sets this dynamically, defaults to 8080)
PORT=8080

# Neon Serverless PostgreSQL Pooled Connection (Port 5432 with SSL & Channel Binding)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-odd-art-b3wr3a72-pooler.c-4.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_DATABASE_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Flyway Database Migration (Runs migrations V1 through V7 automatically at startup)
SPRING_FLYWAY_ENABLED=true

# JWT Stateless Authentication (256-bit Base64-encoded secret key)
# Generate via: openssl rand -base64 32
APP_JWT_SECRET=YOUR_BASE64_ENCODED_256BIT_SECRET_KEY
APP_JWT_EXPIRATION_MS=86400000

# Canonical Production Frontend URL
FRONTEND_URL=https://frontend-seven-zeta-99.vercel.app

# Allowed CORS Origins (Comma-separated domains permitted for API requests)
APP_CORS_ALLOWED_ORIGINS=https://frontend-seven-zeta-99.vercel.app,https://*.vercel.app,https://emergency-alert-and-hospital-assist.vercel.app,https://emergency-alert-and-hospital-assistance-system.vercel.app,http://localhost:5173,http://localhost:3000

# Optional: Google Gemini AI API Key for automated clinical triage and severity assessment
GEMINI_API_KEY=YOUR_GEMINI_API_KEY


# =============================================================================
# 2. NEON POSTGRESQL & DATA API CONFIGURATION
# =============================================================================

DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-odd-art-b3wr3a72-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-odd-art-b3wr3a72-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_POOLER_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-odd-art-b3wr3a72-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channelBinding=require
NEON_DATA_API_URL=https://ep-odd-art-b3wr3a72.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1


# =============================================================================
# 3. VERCEL FRONTEND WEB APP (Mandatory for Frontend Deployment)
# Configure these in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# =============================================================================

# Backend REST API endpoint (Render live deployment)
VITE_API_BASE_URL=https://emergency-alert-and-hospital-assistance.onrender.com

# OpenStreetMap tile server URL (Standard OpenStreetMap tiles)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Neon Data API endpoint
VITE_NEON_DATA_API_URL=https://ep-odd-art-b3wr3a72.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1


# =============================================================================
# 4. OBJECT & MEDICAL DOCUMENT STORAGE (Supabase S3-Compatible)
# Optional: Local fallback disk storage is active if left empty
# =============================================================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=emergency-attachments
