# Environment Configuration for Emergency Alert and Hospital Assistance System
# B.Tech Community Service Project - VVIT Batch 8 (VSK)

# Spring Profile: 'dev' uses fast zero-config in-memory H2 with seed data.
# Set to 'mysql' for production/local MySQL 9.5 service.
SPRING_PROFILES_ACTIVE=dev

# MySQL Configuration (Active when SPRING_PROFILES_ACTIVE=mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/emergency_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Online AI Integration (Google Gemini API - Optional Backend Key)
GEMINI_API_KEY=
