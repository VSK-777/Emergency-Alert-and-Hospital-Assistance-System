# =============================================================================
# Environment Configuration Template
# Emergency Alert and Hospital Assistance System — VVIT CSP
# =============================================================================

# Active Spring Profile:
# - 'postgres' for Supabase PostgreSQL Production / Staging deployment
# - 'dev' for fast zero-config in-memory H2 development with testing seeds
SPRING_PROFILES_ACTIVE=postgres

# Supabase PostgreSQL Configuration (Session Pooler - Port 5432)
# Retrieve exact host and credentials from: Supabase Dashboard -> Connect -> Session Pooler -> JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<SESSION_POOLER_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DATABASE_PASSWORD>

# JWT Stateless Authentication Security
# Generate a strong 256-bit Base64-encoded secret (e.g. openssl rand -base64 32)
APP_JWT_SECRET=<STRONG_BASE64_ENCODED_256BIT_SECRET>
APP_JWT_EXPIRATION_MS=86400000

# CORS Whitelist (Comma-separated frontend domains)
APP_CORS_ALLOWED_ORIGINS=https://emergency-alert-and-hospital-assistance-system.vercel.app,http://localhost:5173

# Server Listen Port
PORT=8080

# Google Gemini AI Clinical Triage (Optional)
GEMINI_API_KEY=
