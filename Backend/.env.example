# =============================================================================
# Production-Ready Environment Configuration Template (.env.example)
# Emergency Alert and Hospital Assistance System — Java Spring Boot Backend
#
# IMPORTANT:
# - This template contains ONLY placeholders and variable definitions.
# - DO NOT put real passwords, secret keys, or credentials into this file.
# - Copy this file to '.env' locally for running or testing against cloud DB:
#     cp .env.example .env
# - Never commit '.env' or any credentials to Git (strictly ignored in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Spring Boot Core Runtime Configuration
# -----------------------------------------------------------------------------
# Active Spring profile:
# - 'prod' or 'postgres' for Render Cloud Deployment (Cloud PostgreSQL + Flyway validation)
# - 'dev' for zero-config local development with in-memory H2 and demonstration seeds
# - 'mysql' for local MySQL service
SPRING_PROFILES_ACTIVE=prod

# Server listening port (Render automatically injects PORT=10000 or custom port)
PORT=8080

# -----------------------------------------------------------------------------
# 2. Relational Database Configuration (Neon or Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Both Neon and Supabase provide PostgreSQL over TLS (sslmode=require).
# For pooled connections on Render, use the connection pooler endpoint (port 5432).
#
# Neon PostgreSQL Format:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-pooler.region.neon.tech:5432/neondb?sslmode=require
#   SPRING_DATASOURCE_USERNAME=neondb_owner
#   SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD
#
# Supabase PostgreSQL Format:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#   SPRING_DATASOURCE_USERNAME=postgres
#   SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Enable Flyway versioned migrations (V1, V2, V3 in src/main/resources/db/migration)
SPRING_FLYWAY_ENABLED=true

# -----------------------------------------------------------------------------
# 3. Supabase Project & Authentication Configuration
# -----------------------------------------------------------------------------
# Supabase project URL and keys obtained from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# 4. Supabase Storage Configuration
# -----------------------------------------------------------------------------
# Dedicated bucket name for medical documents, triage reports, and identity files
SUPABASE_STORAGE_BUCKET=emergency-attachments

# -----------------------------------------------------------------------------
# 5. Security & JWT Stateless Authentication
# -----------------------------------------------------------------------------
# The backend uses an integrated HMAC-SHA256 JWT service (JJWT 0.12.6).
# In 'prod' / 'postgres' profiles, this secret is strictly validated at startup:
# it MUST be a valid Base64 string that decodes to at least 256 bits (32 bytes).
# Generate securely via terminal: openssl rand -base64 32
APP_JWT_SECRET=YOUR_BASE64_ENCODED_256BIT_SECRET_KEY
APP_JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# 6. Frontend URL & CORS Whitelist Configuration
# -----------------------------------------------------------------------------
# Primary production Vercel frontend deployment URL
FRONTEND_URL=https://YOUR_VERCEL_DOMAIN.vercel.app

# Comma-separated list of allowed CORS origins
APP_CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# 7. External AI & Cloud Integrations (Optional)
# -----------------------------------------------------------------------------
# Google Gemini API key for automated clinical triage and symptom summarization
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
